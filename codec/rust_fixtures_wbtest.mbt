// Rust fst 0.4.7 oracle fixtures; original binary files and generation metadata
// are in fixtures/. Byte literals let these tests run on every backend without
// filesystem imports. No fixture bytes are counted as production implementation.

///|
fn oracle_lookup(data : Bytes, key : Bytes) -> UInt64? raise CodecError {
  let header = read_header(data)
  let mut node = read_node(data, header, header.root)
  let mut output = 0UL
  for input in key {
    let mut next : Transition? = None
    for transition in node.transitions {
      if transition.input == input {
        next = Some(transition)
        break
      }
    }
    match next {
      None => return None
      Some(transition) => {
        output = output + transition.output
        node = read_node(data, header, transition.addr)
      }
    }
  }
  if node.is_final {
    Some(output + node.final_output)
  } else {
    None
  }
}

///|
test "Rust 0.4.7 set_empty" {
  let data : Bytes = b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x12\x00\x00\x00\x00\x00\x00\x00\x54\x6b\x2d\x0f"
  verify(data)
  @debug.assert_eq(read_header(data).len, 0UL)
  let buffer = begin(0UL)
  let root = write_node(buffer, false, 0UL, [])
  @debug.assert_eq(finish(buffer, root~, len=0UL), data)
}

///|
test "Rust 0.4.7 set_empty_key" {
  let data : Bytes = b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xc4\x67\x95\x36"
  verify(data)
  @debug.assert_eq(read_header(data).len, 1UL)
  @debug.assert_eq(oracle_lookup(data, b""), Some(0UL))
  let buffer = begin(0UL)
  let root = write_node(buffer, true, 0UL, [])
  @debug.assert_eq(finish(buffer, root~, len=1UL), data)
}

///|
test "Rust 0.4.7 map_empty_key_max" {
  let data : Bytes = b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x08\x00\x40\x01\x00\x00\x00\x00\x00\x00\x00\x1a\x00\x00\x00\x00\x00\x00\x00\xbb\x6c\x3f\xa9"
  verify(data)
  @debug.assert_eq(read_header(data).len, 1UL)
  @debug.assert_eq(oracle_lookup(data, b""), Some(18446744073709551615UL))
  let buffer = begin(0UL)
  let root = write_node(buffer, true, 0xffffffffffffffffUL, [])
  @debug.assert_eq(finish(buffer, root~, len=1UL), data)
}

