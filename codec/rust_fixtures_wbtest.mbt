  @debug.assert_eq(oracle_lookup(data, b"\xff"), Some(16711935UL))
  let buffer = begin(0UL)
  let transitions = Array::makei(256, fn(i) {
    Transition::{
      input: i.to_byte(),
      output: i.to_uint64() * 65537UL,
      addr: 0,
    }
  })
  let root = write_node(buffer, false, 0UL, transitions)
  @debug.assert_eq(finish(buffer, root~, len=256UL), data)
}

///|
test "Rust 0.4.7 map_u64_boundaries" {
  let data : Bytes = b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x62\x61\x18\x42\x00\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x80\xff\xff\xff\xff\xff\xff\xff\x7f\x00\x00\x00\x00\x00\x00\x00\x01\xff\xff\xff\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x01\x00\xff\xff\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\xff\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\xff\xff\xff\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\xff\xff\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\xff\x00\x00\x00\x00\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\x7f\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x7a\x12\x11\x10\x0f\x0e\x0d\x0c\x0b\x0a\x09\x08\x07\x06\x05\x04\x03\x02\x01\x00\x18\x14\x16\x00\x00\x00\x00\x00\x00\x00\xf7\x00\x00\x00\x00\x00\x00\x00\xce\xb0\xc0\x1d"
  verify(data)
  @debug.assert_eq(read_header(data).len, 22UL)
  @debug.assert_eq(oracle_lookup(data, b"\x00"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x01"), Some(1UL))
  @debug.assert_eq(oracle_lookup(data, b"\x02"), Some(127UL))
  @debug.assert_eq(oracle_lookup(data, b"\x03"), Some(128UL))
  @debug.assert_eq(oracle_lookup(data, b"\x04"), Some(255UL))
  @debug.assert_eq(oracle_lookup(data, b"\x05"), Some(256UL))
  @debug.assert_eq(oracle_lookup(data, b"\x06"), Some(65535UL))
  @debug.assert_eq(oracle_lookup(data, b"\x07"), Some(65536UL))
  @debug.assert_eq(oracle_lookup(data, b"\x08"), Some(16777215UL))
  @debug.assert_eq(oracle_lookup(data, b"\x09"), Some(16777216UL))
  @debug.assert_eq(oracle_lookup(data, b"\x0a"), Some(4294967295UL))
  @debug.assert_eq(oracle_lookup(data, b"\x0b"), Some(4294967296UL))
  @debug.assert_eq(oracle_lookup(data, b"\x0c"), Some(281474976710655UL))
  @debug.assert_eq(oracle_lookup(data, b"\x0d"), Some(281474976710656UL))
  @debug.assert_eq(oracle_lookup(data, b"\x0e"), Some(72057594037927935UL))
  @debug.assert_eq(oracle_lookup(data, b"\x0f"), Some(72057594037927936UL))
  @debug.assert_eq(oracle_lookup(data, b"\x10"), Some(9223372036854775807UL))
  @debug.assert_eq(oracle_lookup(data, b"\x11"), Some(9223372036854775808UL))
  @debug.assert_eq(oracle_lookup(data, b"\x12"), Some(18446744073709551615UL))
  @debug.assert_eq(oracle_lookup(data, b"\x7a"), Some(18446744073709551615UL))
  @debug.assert_eq(oracle_lookup(data, b"\x7a\x61"), Some(0UL))
  @debug.assert_eq(
    oracle_lookup(data, b"\x7a\x62"),
    Some(18446744073709551614UL),
  )
}

///|
test "Rust 0.4.7 map_shared_affixes" {
  let data : Bytes = b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x10\xaa\xc8\xdb\xdb\xd3\xc6\xd1\xcb\xc4\xd0\xd0\xc4\xca\xc3\x09\x08\x07\x06\x05\x04\x03\x02\x01\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x39\x38\x37\x36\x35\x34\x33\x32\x31\x30\x11\x0a\x07\x06\x05\x04\x03\x02\x01\x00\x21\x21\x21\x21\x21\x21\x21\x21\x37\x36\x35\x34\x33\x32\x31\x30\x11\x08\x28\x1e\x14\x0a\x00\x01\x1b\x1b\x1b\x1b\x34\x33\x32\x31\x30\x11\x05\xd4\xc3\xd0\xc2\xc1\xc8\xc3\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x39\x38\x37\x36\x35\x34\x33\x32\x31\x30\x10\x0a\x17\x17\x17\x17\x33\x32\x31\x30\x10\x04\x01\x0b\x0b\x32\x31\x30\x10\x03\xd4\xc3\xc2\xca\xc5\xc9\xc6\xc2\xd0\xc5\xcb\x80\x04\x00\x00\x00\x00\x00\x00\xa4\x00\x00\x00\x00\x00\x00\x00\xe5\xd1\x99\x9c"
  verify(data)
  @debug.assert_eq(read_header(data).len, 1152UL)
  @debug.assert_eq(
    oracle_lookup(
      data, b"\x6e\x61\x6d\x65\x73\x70\x61\x63\x65\x2f\x30\x30\x30\x2f\x69\x74\x65\x6d\x2f\x30\x30\x30\x2f\x63\x6f\x6d\x6d\x6f\x6e\x2d\x73\x75\x66\x66\x69\x78",
    ),
    Some(0UL),
  )
  @debug.assert_eq(
    oracle_lookup(
      data, b"\x6e\x61\x6d\x65\x73\x70\x61\x63\x65\x2f\x30\x30\x30\x2f\x69\x74\x65\x6d\x2f\x30\x30\x31\x2f\x63\x6f\x6d\x6d\x6f\x6e\x2d\x73\x75\x66\x66\x69\x78",
    ),
    Some(1UL),
  )
  @debug.assert_eq(
    oracle_lookup(
      data, b"\x6e\x61\x6d\x65\x73\x70\x61\x63\x65\x2f\x30\x31\x32\x2f\x69\x74\x65\x6d\x2f\x30\x30\x30\x2f\x63\x6f\x6d\x6d\x6f\x6e\x2d\x73\x75\x66\x66\x69\x78",
    ),
    Some(0UL),
  )
  @debug.assert_eq(
    oracle_lookup(
      data, b"\x6e\x61\x6d\x65\x73\x70\x61\x63\x65\x2f\x30\x32\x33\x2f\x69\x74\x65\x6d\x2f\x30\x34\x36\x2f\x63\x6f\x6d\x6d\x6f\x6e\x2d\x73\x75\x66\x66\x69\x78",
    ),
    Some(46UL),
  )
  @debug.assert_eq(
    oracle_lookup(
      data, b"\x6e\x61\x6d\x65\x73\x70\x61\x63\x65\x2f\x30\x32\x33\x2f\x69\x74\x65\x6d\x2f\x30\x34\x37\x2f\x63\x6f\x6d\x6d\x6f\x6e\x2d\x73\x75\x66\x66\x69\x78",
    ),
    Some(47UL),
  )
}

///|
test "Rust 0.4.7 set_raw_bytes" {
  let data : Bytes = b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\x00\x10\x42\x00\x10\x9a\x00\x01\xff\x00\x10\x02\x00\x10\xaf\x80\x00\x10\xae\x80\xba\xc0\xe4\xc0\x88\xc0\x9c\xc0\x00\x10\x80\x80\xa0\xc0\x20\x01\x07\x13\x00\x00\x17\x00\x20\xff\xed\xe6\xc0\x80\x7f\x61\x01\x00\x10\x49\x0f\x00\x00\x00\x00\x00\x00\x00\x48\x00\x00\x00\x00\x00\x00\x00\xb9\xa5\x54\xd2"
  verify(data)
  @debug.assert_eq(read_header(data).len, 15UL)
  @debug.assert_eq(oracle_lookup(data, b""), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x00"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x00\x00"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x00\xff"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x01"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x61\x00\x62"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x61\xff"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x7f"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\x80"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\xc0\xaf"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\xe6\x9c\x88\xe4\xba\xae"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\xed\xa0\x80"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\xff"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\xff\x00"), Some(0UL))
  @debug.assert_eq(oracle_lookup(data, b"\xff\xff"), Some(0UL))
}

///|
test "Rust 0.4.7 map_raw_bytes" {
  let data : Bytes = b"\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x8c\x49\x12\x32\x55\x75\x6a\xb1\xb8\xcf\x30\x30\x39\x54\x01\x0c\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xff\x00\x18\x42\x00\x10\x9a\x12\x1c\x01\x6e\xc8\xf8\x80\x68\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\xff\x00\x18\x02\x00\x10\xaf\x80\x00\x10\xae\x80\xba\xc0\xe4\xc0\x88\xc0\x9c\xc0\x00\x10\x80\x80\xa0\xc0\x00\x00\x00\x00\x00\x00\x00\x00\xba\xf2\xb5\x72\x78\x33\x81\xb3\x2d\xd0\x62\x3a\x52\xec\x6a\x4b\x00\x00\xff\x00\x18\x42\x68\x07\x52\x3d\xdb\x1c\x28\x49\xe7\x68\x9c\x32\xe5\x63\xf3\x47\x70\xc1\x15\xcc\x8d\xc7\x68\xc2\x59\x07\x1d\x19\xac\x29\x6a\x89\x5f\x97\xae\x0a\xd3\xd1\xb2\x3d\xc6\x0b\x27\xca\xbb\x8c\xe2\x87\x80\x40\x9a\x86\x18\xbe\x77\x6d\xe9\x20\xbf\x0e\x14\x99\xcd\x6b\x67\xd3\xb0\xd2\xb6\x2c\x76\x63\x4f\x3c\xc2\x4d\xde\x36\xd4\x38\x01\x1f\x25\x31\x00\x00\x35\x00\x4e\xff\xed\xe6\xc0\x80\x7f\x61\x01\x00\x18\x49\x0f\x00\x00\x00\x00\x00\x00\x00\xde\x00\x00\x00\x00\x00\x00\x00\x5b\xf7\x99\xfe"
  verify(data)
  @debug.assert_eq(read_header(data).len, 15UL)
  @debug.assert_eq(oracle_lookup(data, b""), Some(5271495091789367144UL))
  @debug.assert_eq(oracle_lookup(data, b"\x00"), Some(16879117790619141595UL))
  @debug.assert_eq(
    oracle_lookup(data, b"\x00\x00"),
    Some(4094958289601838159UL),
  )
  @debug.assert_eq(
    oracle_lookup(data, b"\x00\xff"),
    Some(4960023497632058375UL),
  )
  @debug.assert_eq(oracle_lookup(data, b"\x01"), Some(7166965020737196903UL))
  @debug.assert_eq(
    oracle_lookup(data, b"\x61\x00\x62"),
    Some(7768033243709776105UL),
  )
  @debug.assert_eq(
    oracle_lookup(data, b"\x61\xff"),
    Some(15298325360395959547UL),
  )
  @debug.assert_eq(oracle_lookup(data, b"\x7f"), Some(7887982284909461632UL))
  @debug.assert_eq(oracle_lookup(data, b"\x80"), Some(9791543278035209158UL))
  @debug.assert_eq(
    oracle_lookup(data, b"\xc0\xaf"),
    Some(4445846486515619679UL),
  )
  @debug.assert_eq(
    oracle_lookup(data, b"\xe6\x9c\x88\xe4\xba\xae"),
    Some(9901772549859903321UL),
  )
  @debug.assert_eq(
    oracle_lookup(data, b"\xed\xa0\x80"),
    Some(14008666052764221808UL),
  )
  @debug.assert_eq(oracle_lookup(data, b"\xff"), Some(5184597432081344743UL))
  @debug.assert_eq(
    oracle_lookup(data, b"\xff\x00"),
    Some(10619013170368297236UL),
  )
  @debug.assert_eq(
    oracle_lookup(data, b"\xff\xff"),
    Some(18119273629279738785UL),
  )
}
